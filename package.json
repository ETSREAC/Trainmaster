{
  "name": "trainmaster",
  "version": "1.7.8",
  "private": true,
  "description": "Moderne, modulare Modellbahn-Steuerung mit Gleisplan, BBT und Automatikbetrieb",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/start.mjs",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "npm run build && node scripts/test_security_fixes.mjs",
    "test:security": "node scripts/test_security_fixes.mjs",
    "license:gen": "node scripts/license_cli.mjs"
  },
  "keywords": ["modelrailroad", "dcc", "rocrail", "train-control", "automation", "bbt"],
  "author": "",
  "license": "MIT"
}
